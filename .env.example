# ============================================================
#  Xiehaoyu-Agent 环境变量配置
#  复制此文件为 .env 并填入真实值
#  cp .env.example .env
# ============================================================

# DeepSeek API (必填)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# CORS 允许的前端地址
# 开发环境: http://localhost:5173
# 生产环境: https://your-domain.com
CORS_ORIGINS=http://localhost:5173

# 限流配置（公开访问）
IP_HOURLY_QUOTA=20
GLOBAL_DAILY_QUOTA=200
# 会话写端点（创建/改名/删除）每 IP 每小时上限（808 审查 M11）
SESSIONS_IP_HOURLY_QUOTA=120

# Agent 配置
MAX_AGENT_STEPS=5
SQL_RETRY_MAX=3

# Embedding API（智谱 AI embedding-3）
# 填入后自动切换到 API 模式（零本地内存）；留空则降级到本地 BGE-large 模型
EMBED_API_KEY=your_zhipuai_api_key_here
EMBED_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBED_MODEL_NAME=embedding-3
# 向量维度：256 / 512 / 1024 / 2048（切换后须重建知识库）
EMBED_DIMENSIONS=1024

# 对话记忆持久化（功能一）
MEMORY_RECENT_TURNS=5
MEMORY_SUMMARY_TRIGGER_TURNS=10
MEMORY_SUMMARY_MIN_NEW_TURNS=3
MEMORY_MAX_SESSIONS_PER_USER=50
MEMORY_MAX_AGE_DAYS=30
MEMORY_CLEANUP_INTERVAL_HOURS=6
SUMMARIZER_TEMPERATURE=0.3
